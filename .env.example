# Copy to .env.local and fill in when Phase 4 begins.
# Nothing here is required for the Phase 1 build.

# Public — exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
