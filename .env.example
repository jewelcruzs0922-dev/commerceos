# Copy to .env.local and fill in. Never commit .env.local.

# Public: exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Enables the one-click read-only demo and the owner reset tool.
DEMO_MODE=false

# Server only. Never prefix with NEXT_PUBLIC_ and never import in client code.
# Not used by the current application code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional staging-only HTTP Basic protection. Leave empty for a public demo.
STAGING_BASIC_USER=
STAGING_BASIC_PASSWORD=
